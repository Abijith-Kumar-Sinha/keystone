# Copy to .env (never commit it). Everything is optional: with no key the agent answers through a deterministic router
# and the UI says so. Visitors can also paste their own key in the app; it is used for that request only.
ANTHROPIC_API_KEY=
KEYSTONE_MODEL=                      # default claude-haiku-5-5

# Or any OpenAI-compatible endpoint. Free options: Google Gemini (key at https://aistudio.google.com/apikey) or Groq.
LLM_API_KEY=
LLM_BASE_URL=                        # Gemini: https://generativelanguage.googleapis.com/v1beta/openai/   Groq: https://api.groq.com/openai/v1
# KEYSTONE_MODEL=gemini-3.6-flash    # Groq: openai/gpt-oss-120b
# LLM2_API_KEY= / LLM2_BASE_URL= / LLM2_MODEL=   a second model, tried when the first is slow or rate-limited
# KEYSTONE_LLM_ORDER=2,1             ask LLM2 first (Groq answers in 2-3 s, Gemini in about 7)
# LLM_REASONING_EFFORT=low           # optional, speeds up reasoning models

# Or a model on your own machine through Ollama (no key; slow on a laptop, fine for testing the agent loop):
#   ollama create keystone-local -f deploy/Modelfile.local
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# KEYSTONE_MODEL=keystone-local

# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_PASSWORD=

# Default graph for the MCP server, and who may write memory: all (local) or sandbox (public demo)
KEYSTONE_TENANT=falkordb
KEYSTONE_WRITABLE=all

# Optional: let the agent open the drafted issues as real GitHub issues in ONE repo you own
# KEYSTONE_GH_REPO=your-name/your-repo
# GITHUB_TOKEN=
